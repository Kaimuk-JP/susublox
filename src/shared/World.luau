return {
	Districts = Districts,
	Roads = Roads,
	KeepOut = KeepOut,
	Plazas = Plazas,
	Zones = Zones,
	Stones = Stones,
	Paved = Paved,
	Hills = Hills,
	Water = Water,
	Bounds = Bounds,
	-- ความสูงเนินที่ระยะ r จากศูนย์กลาง (ใช้ทั้ง TerrainBake และตอนวางบันได/ต้นไม้)
	HillHeight = function(h: { x: number, z: number, r0: number, r1: number, top: number }, r: number): number
		if r <= h.r0 then
			return h.top
		elseif r >= h.r1 then
			return 0
		end
		return h.top * (h.r1 - r) / (h.r1 - h.r0)
	end,
	-- สี่เหลี่ยมที่ถนนครอบ (x1, x2, z1, z2) ไม่รวมส่วนต่อปลาย
	RoadRect = function(r: { any }, pad: number?): (number, number, number, number)
		local p = pad or 0
		local w = r[5] / 2 + p
		if math.abs(r[3] - r[1]) >= math.abs(r[4] - r[2]) then
			return math.min(r[1], r[3]), math.max(r[1], r[3]), r[2] - w, r[2] + w
		end
		return r[1] - w, r[1] + w, math.min(r[2], r[4]), math.max(r[2], r[4])
	end,
	-- จุด (x, z) อยู่บนถนน (ห่างขอบไม่เกิน margin) หรือไม่ — ข้ามทางป่า (T) ถ้า skipTrail
	OnRoad = function(x: number, z: number, margin: number, skipTrail: boolean?): boolean
		for _, r in Roads do
			if not (skipTrail and r[6] == "T") then
				local w = r[5] / 2 + margin
				local x1, x2 = math.min(r[1], r[3]), math.max(r[1], r[3])
				local z1, z2 = math.min(r[2], r[4]), math.max(r[2], r[4])
				if math.abs(r[3] - r[1]) >= math.abs(r[4] - r[2]) then
					z1 -= w
					z2 += w
					x1 -= margin
					x2 += margin
				else
					x1 -= w
					x2 += w
					z1 -= margin
					z2 += margin
				end
				if x >= x1 and x <= x2 and z >= z1 and z <= z2 then
					return true
				end
			end
		end
		return false
	end,
	-- ช่วงปลอดโล่ง (ไม่ถูกถนนอื่นตัดผ่าน) ของเส้นขอบถนนเส้นที่ index ด้านที่ side ห่างจากกลางถนน off: ใช้เว้นขอบทาง/เส้นขาวตรงแยก
	-- คืน { {a, b}, ... } เป็นพิกัดตามแนวถนน (x ถ้าถนนนอน, z ถ้าถนนตั้ง)
	FreeIntervals = function(index: number, off: number): { { number } }
		local r = Roads[index]
		local horizontal = math.abs(r[3] - r[1]) >= math.abs(r[4] - r[2])
		local lo = if horizontal then math.min(r[1], r[3]) else math.min(r[2], r[4])
		local hi = if horizontal then math.max(r[1], r[3]) else math.max(r[2], r[4])
		local fixed = if horizontal then r[2] + off else r[1] + off
		local cuts: { { number } } = {}
		for j, o in Roads do
			if j ~= index and o[6] ~= "T" then
				local ox1, ox2, oz1, oz2 = math.min(o[1], o[3]), math.max(o[1], o[3]), math.min(o[2], o[4]), math.max(o[2], o[4])
				local oh = math.abs(o[3] - o[1]) >= math.abs(o[4] - o[2])
				if oh ~= horizontal then
					local hw = o[5] / 2
					if horizontal then
						-- o ตั้ง: ตัดเมื่อเส้น z=fixed อยู่ในช่วง z ของ o และ x ของ o อยู่ในช่วงถนนเรา
						if fixed >= oz1 - 0.3 and fixed <= oz2 + 0.3 then
							table.insert(cuts, { o[1] - hw, o[1] + hw })
						end
					else
						if fixed >= ox1 - 0.3 and fixed <= ox2 + 0.3 then
							table.insert(cuts, { o[2] - hw, o[2] + hw })
						end
					end
				end
			end
		end
		table.sort(cuts, function(a, b)
			return a[1] < b[1]
		end)
		local out: { { number } } = {}
		local cur = lo
		for _, c in cuts do
			if c[2] > cur and c[1] < hi then
				if c[1] > cur then
					table.insert(out, { cur, c[1] })
				end
				cur = math.max(cur, c[2])
			end
		end
		if cur < hi then
			table.insert(out, { cur, hi })
		end
		return out
	end,
	ById = function(id: string): District?
		for _, d in Districts do
			if d.Id == id then
				return d
			end
		end
		return nil
	end,
}
